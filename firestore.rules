rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // User can read their own user document
      allow read: if isOwner(userId);
      
      // User can create their own profile upon registration with free tier
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.isPro == false
                    && request.resource.data.plan == 'free'
                    && request.resource.data.paypalOrderId == null
                    && request.resource.data.paypalTransactionId == null
                    && request.resource.data.proActivatedAt == null;
      
      // User cannot modify isPro, plan, paypalOrderId, paypalTransactionId, proActivatedAt, or beta fields directly from client
      allow update: if isOwner(userId)
                    && request.resource.data.isPro == resource.data.isPro
                    && request.resource.data.plan == resource.data.plan
                    && request.resource.data.paypalOrderId == resource.data.paypalOrderId
                    && request.resource.data.paypalTransactionId == resource.data.paypalTransactionId
                    && request.resource.data.proActivatedAt == resource.data.proActivatedAt
                    && (!('isBeta' in request.resource.data) || request.resource.data.isBeta == resource.data.get('isBeta', false))
                    && (!('betaGenerationsRemaining' in request.resource.data) || request.resource.data.betaGenerationsRemaining == resource.data.get('betaGenerationsRemaining', 0));
      
      allow delete: if false;

      // Subcollection for user's saved blueprints
      match /savedProjects/{projectId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Beta access codes collection: server-authoritative Admin SDK access only
    match /beta_codes/{codeId} {
      allow read, write: if false;
    }
  }
}
